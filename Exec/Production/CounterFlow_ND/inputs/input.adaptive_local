#-------------------------ADAPTIVE INTEGRATOR----------------------------
peleLM.chem_integrator = "ReactorAdaptive"
peleLM.use_typ_vals_chem = 1

# Sub-reactor selection
adaptive.primary_integrator  = "ReactorQSS"    # fast explicit — cold/inert cells
adaptive.fallback_integrator = "ReactorCvode"  # implicit BDF — flame/ignition cells

# Routing condition: TRUE → primary (QSS), FALSE → fallback (CVODE)
# Combined AND: T < T_threshold AND Y_OH < Y_threshold → QSS
#               otherwise (T high OR OH high)           → CVODE
adaptive.condition_type  = "combined"
adaptive.condition_logic = "AND"

# Temperature threshold: start at 1200 K, adjust based on results.
# Lower → more cells go to CVODE (safer). Higher → more to QSS (faster).
adaptive.T_threshold = 450

# OH radical: marks the active reaction zone
adaptive.species_name = "OH"
adaptive.Y_threshold  = 1.0e-10

# Verbosity: 1 prints per-box primary/fallback cell counts
adaptive.verbose = 1

# Shared ODE tolerances
ode.rtol = 1.0e-6
ode.atol = 1.0e-5

# QSS-specific parameters
